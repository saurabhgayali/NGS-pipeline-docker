# NGS Pipeline Web Wrapper - Environment Configuration
# Copy this file to .env and customize for your deployment

# ============================================================================
# WEB SERVER CONFIGURATION
# ============================================================================

# Web server port
PORT=7860

# Web server host (0.0.0.0 = accessible from outside container)
HOST=0.0.0.0

# Enable debug mode (set to 'false' for production)
DEBUG=false

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# DATA DIRECTORIES
# ============================================================================

# Base directory for all data
BASE_DATA_DIR=/app/data

# Scripts directory
SCRIPTS_DIR=/app/scripts

# Python scripts directory
PYTHON_SCRIPTS_DIR=/app/python_scripts

# ============================================================================
# PIPELINE CONFIGURATION
# ============================================================================

# Number of threads for parallel processing (adjust based on system)
THREADS=8

# Reference genome path (relative to BASE_DATA_DIR)
REFERENCE_GENOME=reference/tb_ref_genome/ncbi_dataset/data/GCF_000195955.2/GCF_000195955.2_ASM19595v2_genomic.fna

# Metadata file for sample selection
METADATA_FILE=metadata/CRyPTIC_reuse_table_20240917.csv

# ============================================================================
# CONDA CONFIGURATION
# ============================================================================

# Conda environment name
CONDA_ENV=ngs_env

# Conda initialization script path
CONDA_INIT_SCRIPT=/opt/miniconda3/etc/profile.d/conda.sh

# ============================================================================
# FILE MONITORING
# ============================================================================

# File settle time before processing (seconds)
FILE_SETTLE_TIME=2

# Minimum file size (bytes) to consider as valid
MIN_FILE_SIZE=1024

# ============================================================================
# EXECUTION CONFIGURATION
# ============================================================================

# Stage execution timeout (seconds, 24 hours default)
STAGE_TIMEOUT=86400

# Maximum file size for uploads (bytes, 10GB default)
MAX_FILE_SIZE=10737418240

# ============================================================================
# DASHBOARD CONFIGURATION
# ============================================================================

# Dashboard auto-refresh interval (seconds)
DASHBOARD_REFRESH_INTERVAL=5

# ============================================================================
# NOTIFICATIONS (Future Enhancement)
# ============================================================================

# Enable email notifications
EMAIL_ENABLED=false

# SMTP server configuration
SMTP_SERVER=localhost
SMTP_PORT=25
FROM_ADDRESS=ngs-pipeline@localhost
TO_ADDRESSES=admin@example.com

# Enable Slack notifications
SLACK_ENABLED=false

# Slack webhook URL (from Slack app configuration)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Slack channel for notifications
SLACK_CHANNEL=#pipeline-notifications

# ============================================================================
# SECURITY
# ============================================================================

# CORS origins (comma-separated, use * for all origins)
CORS_ORIGINS=*

# Enable CORS credentials
CORS_CREDENTIALS=true

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================

# uvicorn workers
WORKERS=1

# Maximum concurrent requests
MAX_CONCURRENT_TASKS=1

# Log file rotation size (MB)
LOG_ROTATION_SIZE=100

# Keep last N log files
LOG_RETENTION_DAYS=7

# ============================================================================
# DOCKER/KUBERNETES
# ============================================================================

# Container environment indicator
ENVIRONMENT=docker

# Python path
PYTHONUNBUFFERED=1
